# First and Last Element of any array

n = int(input())
arr = list(map(int,input().split()))
x = int(input())

def First(arr, x):
	low = 0
	high = len(arr)-1
	res = -1
	
	while low <= high:
		mid = (low + high) // 2
		
		if arr[mid] > x:
			high = mid -1
		elif arr[mid] < x:
			low = mid + 1
		else:
			res = mid
			high = mid -1
	return res

def last(arr,x):
	low = 0
	high = len(arr) -1
	res = -1
	
	while low <= high:
		mid = (low + high) // 2
		if arr[mid] > x:
			high = mid -1
		elif arr[mid] < x:
			low = mid + 1
		else:
			res = mid 
			low = mid + 1
			
	return res
print(First(arr,x), last(arr, x))
