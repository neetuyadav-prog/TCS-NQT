# Lower bound using binary Search

n = int(input())
arr = list(map(int,input().split()))
target = int(input())

def lower_bound(arr, target):
    low = 0
    high = len(arr) - 1
    ans = len(arr)

    while low <= high:
        mid = (low + high) // 2

        if arr[mid] >= target:
            ans = mid
            high = mid - 1
        else:
            low = mid + 1
    return ans
print(lower_bound(arr,target))
